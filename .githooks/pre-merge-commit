#!/usr/bin/env bash
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || true)"
git_dir="$(git rev-parse --git-dir)"

if [[ "$branch" == "main" && ! -f "$git_dir/agent-workflow-promotion-authorized" ]]; then
  echo "A merge commit on main requires the guarded human-approved promotion script." >&2
  exit 1
fi

"$(git rev-parse --show-toplevel)/.githooks/pre-commit"
