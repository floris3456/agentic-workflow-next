#!/usr/bin/env bash
set -euo pipefail

zero="0000000000000000000000000000000000000000"

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "$remote_ref" ]] || continue
  [[ "$remote_ref" == "refs/heads/template-development" || "$remote_ref" == "refs/heads/workspace" ]] || {
    echo "This maintenance checkout may push only the active rename pair." >&2
    exit 1
  }
  if [[ "$local_oid" == "$zero" ]]; then
    [[ "$remote_ref" == "refs/heads/template-development" && "$(git branch --show-current)" == "workspace" && "$(git rev-parse workspace)" == "$remote_oid" ]] || {
      echo "Branch deletion is allowed only for the exact retired template-development ref during the workspace rename." >&2
      exit 1
    }
    continue
  fi
  if [[ "$remote_oid" != "$zero" ]] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid"; then
    echo "Non-fast-forward maintenance push is blocked." >&2
    exit 1
  fi
done
