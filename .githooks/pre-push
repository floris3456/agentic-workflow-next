#!/usr/bin/env bash
set -euo pipefail

remote_name="${1:-}"
git_dir="$(git rev-parse --git-dir)"
zero="0000000000000000000000000000000000000000"
promotion="$git_dir/agent-workflow-promotion-authorized"
template_repair="$git_dir/agent-workflow-template-repair-authorized"

valid_template_repair() {
  local local_oid="$1"
  local remote_ref="$2"
  local remote_oid="$3"
  [[ "$remote_name" == "origin" && "$remote_ref" == "refs/heads/developer" && -f "$template_repair" ]] || return 1
  local expected_old=""
  local expected_new=""
  local expected_main=""
  local extra=""
  read -r expected_old expected_new expected_main extra < "$template_repair" || return 1
  [[ -z "$extra" && "$remote_oid" == "$expected_old" && "$local_oid" == "$expected_new" ]] || return 1
  [[ "$(git rev-list --parents -n 1 "$expected_old" | wc -w)" -eq 1 ]] || return 1
  [[ "$(git rev-list --parents -n 1 "$expected_main" | wc -w)" -eq 1 ]] || return 1
  [[ "$(git rev-list --parents -n 1 "$expected_new" | wc -w)" -eq 2 ]] || return 1
  [[ "$(git rev-parse "$expected_new^1")" == "$expected_main" ]] || return 1
  [[ "$(git rev-parse "$expected_new^{tree}")" == "$(git rev-parse "$expected_old^{tree}")" ]] || return 1
}

while read -r local_ref local_oid remote_ref remote_oid; do
  [[ -n "$remote_ref" ]] || continue

  if [[ "$local_oid" == "$zero" ]]; then
    echo "Branch/ref deletion is blocked by the agentic workflow." >&2
    exit 1
  fi

  if [[ "$remote_oid" != "$zero" ]] && ! git merge-base --is-ancestor "$remote_oid" "$local_oid" \
    && ! valid_template_repair "$local_oid" "$remote_ref" "$remote_oid"; then
    echo "Non-fast-forward push to $remote_ref is blocked. Preserve auditable shared history." >&2
    exit 1
  fi

  if [[ "$remote_ref" == "refs/heads/main" ]]; then
    if [[ ! -f "$promotion" ]]; then
      echo "Direct main push is blocked. Use scripts/promote-developer-to-main.sh after exact human approval." >&2
      exit 1
    fi

    read -r expected_merge approved_developer expected_main < "$promotion"
    if [[ "$local_oid" != "$expected_merge" ]]; then
      echo "Main push does not match the guarded promotion merge commit." >&2
      exit 1
    fi
    if [[ "$(git rev-parse "$local_oid^2" 2>/dev/null || true)" != "$approved_developer" ]]; then
      echo "Promotion merge second parent is not the human-approved developer SHA." >&2
      exit 1
    fi
    if [[ "$(git rev-list --parents -n 1 "$local_oid" | wc -w)" -ne 3 ]]; then
      echo "Promotion merge must have exactly two parents." >&2
      exit 1
    fi
    if [[ "$(git rev-parse "$local_oid^{tree}")" != "$(git rev-parse "$approved_developer^{tree}")" ]]; then
      echo "Promotion merge tree differs from the human-approved developer tree." >&2
      exit 1
    fi
    if [[ "$remote_oid" != "$expected_main" ]]; then
      echo "origin/main moved after promotion preparation; re-review is required." >&2
      exit 1
    fi
  fi
done

exit 0
