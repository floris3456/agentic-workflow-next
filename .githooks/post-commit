#!/usr/bin/env bash
set -u

branch="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
[[ "$branch" == "developer" ]] || exit 0

git_dir="$(git rev-parse --git-dir)"
marker="$git_dir/agent-workflow-sync-failed"
sha="$(git rev-parse HEAD)"

if git push origin "HEAD:refs/heads/developer"; then
  rm -f "$marker"
  echo "Agentic workflow synchronization: pushed developer at $sha" >&2
  exit 0
fi

{
  printf '%s\n' "developer"
  printf '%s\n' "$sha"
  date -u +'%Y-%m-%dT%H:%M:%SZ'
} > "$marker"

cat >&2 <<EOF
 Agentic workflow synchronization failed.
Local commit $sha is not confirmed on origin/developer.
Implementation must stop; the next commit will be blocked until synchronization is recovered.
EOF

# Git ignores post-commit status; stderr and the marker carry the failure state.
exit 1
