#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"
[[ "$branch" == "workspace" ]] || {
  echo "This checkout permits commits only on workspace; current state is ${branch:-detached HEAD}." >&2
  exit 1
}
marker="$(git rev-parse --git-dir)/workspace-sync-failed"
[[ ! -e "$marker" ]] || {
  echo "A prior workspace push failed. Recover synchronization before committing." >&2
  exit 1
}
