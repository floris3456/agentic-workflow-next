#!/usr/bin/env bash
set -euo pipefail

branch="$(git branch --show-current)"
[[ "$branch" == "template-development" || "$branch" == "workspace" ]] || {
  echo "This maintenance checkout permits commits only on the active rename pair; current state is ${branch:-detached HEAD}." >&2
  exit 1
}
marker="$(git rev-parse --git-dir)/${branch}-sync-failed"
[[ ! -e "$marker" ]] || {
  echo "A prior ${branch} push failed. Recover synchronization before committing." >&2
  exit 1
}
