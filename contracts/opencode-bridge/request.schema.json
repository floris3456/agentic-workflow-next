{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-workflow/opencode-bridge/request.schema.json",
  "title": "Agentic bridge sequence-free recovery and Scout request envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request_id", "task_id", "kind", "arguments"],
  "properties": {
    "protocol": { "const": "agentic-bridge/1" },
    "request_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "task_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "kind": { "enum": ["command.status", "task.status", "scout.start", "scout.status"] },
    "arguments": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "command.status" } } },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command_id"],
            "properties": {
              "command_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "task.status" } } },
      "then": {
        "properties": {
          "arguments": { "type": "object", "additionalProperties": false, "maxProperties": 0 }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "scout.start" } } },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question", "ref", "scope", "expected_evidence"],
            "properties": {
              "question": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "ref": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
              "scope": { "type": "string", "minLength": 1, "maxLength": 2000 },
              "expected_evidence": { "type": "string", "minLength": 1, "maxLength": 2000 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "scout.status" } } },
      "then": {
        "properties": {
          "arguments": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scout_request_id"],
            "properties": {
              "scout_request_id": {
                "type": "string",
                "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
              }
            }
          }
        }
      }
    }
  ]
}
