{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agentic-workflow/opencode-bridge/result.schema.json",
  "title": "Agentic bridge public command status",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "command_id", "task_id", "sequence", "state"],
  "properties": {
    "protocol": { "const": "agentic-bridge/1" },
    "command_id": { "type": "string", "format": "uuid" },
    "task_id": { "type": "string" },
    "sequence": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["accepted", "applying", "succeeded", "failed", "rejected", "indeterminate"] }
  }
}
