+      worktree,
+      entry,
+      public: {
+        target: targetName(entry),
+        branch: branch?.startsWith("refs/heads/") ? branch.slice("refs/heads/".length) : null,
+        head,
+        clean: treeStatus.clean,
+        status_digest: treeStatus.digest,
+        status: treeStatus.entries,
