+  `);
+  const ts = Date.now();
+  for (const [key, value] of Object.entries(metadata)) {
+    db.prepare("INSERT OR REPLACE INTO meta (key, value, updated_at) VALUES (?, ?, ?)").run(key, String(value), ts);
+  }
+  return db;
+}
