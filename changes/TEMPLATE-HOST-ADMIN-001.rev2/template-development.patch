+  const words = [];
+  let current = "";
+  let quote = null;
+  let started = false;
+  for (let index = 0; index < command.length;) {
+    const char = command[index];
+    if (char === "\\") {
+      const decoded = decodeExecEscape(command, index);
+      if (!decoded) return null;
+      current += decoded.value;
+      started = true;
+      index = decoded.next;
+      continue;
+    }
+    if (quote !== null) {
+      if (char === quote) {
+        quote = null;
+      } else {
+        current += char;
+      }
+      started = true;
+      index++;
+      continue;
+    }
+    if (char === "\"" || char === "'") {
+      quote = char;
+      started = true;
+      index++;
+      continue;
+    }
+    if (/\s/.test(char)) {
+      if (started) {
+        words.push(current);
+        current = "";
+        started = false;
+      }
+      index++;
+      continue;
+    }
+    current += char;
+    started = true;
+    index++;
+  }
+  if (quote !== null) return null;
+  if (started) words.push(current);
+  return words.length > 0 ? words : null;
